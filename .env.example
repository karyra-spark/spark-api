# Karyra Spark API local development configuration.
# This file is safe to commit. Copy it to .env for local development.

APP_ENV=development
RUST_LOG=spark_api=info,tower_http=info

SPARK_API_HOST=127.0.0.1
SPARK_API_PORT=8787
SPARK_WEB_ORIGIN=http://127.0.0.1:5173

# Local-only PostgreSQL connection used by infra/docker-compose.local.yml.
# Replace this in staging/production through deployment secrets.
DATABASE_URL=postgres://spark:spark_dev_password@127.0.0.1:5432/spark
DATABASE_MAX_CONNECTIONS=5

# Local-only S3-compatible object storage used by infra/docker-compose.local.yml.
# MinIO/Garage/R2 production credentials must be provided by deployment secrets.
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET_PUBLIC=spark-public
S3_BUCKET_PRIVATE=spark-private

SPARK_SESSION_COOKIE=spark_session
SPARK_SESSION_TTL_DAYS=14
SPARK_COOKIE_SECURE=false
